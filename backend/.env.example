# AWS Credentials
# Leave empty if using AWS CLI (~/.aws/credentials or AWS IAM role)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# If using AWS Academy / Learner Lab, paste AWS_SESSION_TOKEN below:
AWS_SESSION_TOKEN=

# CloudWatch Settings
LOG_GROUP_NAME=/centralized-log-error-counter
LOG_STREAM_NAME=demo-stream

# MQTT Broker Settings
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=centralized/logs/error-count

# Backend Server
BACKEND_PORT=8000
